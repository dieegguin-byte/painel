{
  "name": "Atendimento — Tapeçaria Bahia",
  "short_name": "Atendimento TB",
  "description": "Hub de atendimento da Tapeçaria e Estofados Bahia: leads, agenda, financeiro e estoque.",
  "start_url": "./nova.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1b1412",
  "theme_color": "#7a3b21",
  "lang": "pt-BR",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Anotar agora", "short_name": "Anotar", "description": "Compromisso, gasto, cliente novo — o Claude organiza depois", "url": "./nova.html?ir=anotar", "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Agenda", "short_name": "Agenda", "description": "Os compromissos por dia", "url": "./nova.html?ir=agenda", "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Caixa", "short_name": "Caixa", "description": "O que chegou e ainda não foi organizado", "url": "./nova.html?ir=caixa", "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Leads", "short_name": "Leads", "description": "Clientes e orçamentos em aberto", "url": "./nova.html?ir=leads", "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "link",
      "files": [
        { "name": "arquivos", "accept": ["image/*", "text/plain", ".txt", "application/zip", "application/x-zip-compressed", ".zip", "audio/*", "video/*", "application/pdf", ".pdf"] }
      ]
    }
  }
}
