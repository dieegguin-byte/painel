{
  "name": "Atendimento — Tapeçaria Bahia",
  "short_name": "Atendimento TB",
  "description": "Hub de atendimento da Tapeçaria e Estofados Bahia: leads, agenda, financeiro e estoque.",
  "start_url": "./nova.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1b1412",
  "theme_color": "#7a3b21",
  "lang": "pt-BR",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icon-maskable.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Calculadora rápida", "short_name": "Calculadora", "description": "Quiz rápido de orçamento: Pix e 6x no cartão", "url": "./nova.html?ir=calculadora", "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Atrasados", "short_name": "Atrasados", "description": "O que passou da hora e precisa resolver", "url": "./nova.html?ir=atrasados", "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Compromissos de hoje", "short_name": "Hoje", "description": "A agenda de hoje, por hora", "url": "./nova.html?ir=hoje", "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Anotar agora", "short_name": "Anotar", "description": "Compromisso, gasto, cliente novo — o Claude organiza depois", "url": "./nova.html?ir=anotar", "icons": [{ "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "link",
      "files": [
        { "name": "arquivos", "accept": ["image/*", "text/*", "text/plain", ".txt", "application/*", "application/zip", "application/x-zip-compressed", ".zip", "audio/*", "video/*", "application/pdf", ".pdf"] }
      ]
    }
  }
}
